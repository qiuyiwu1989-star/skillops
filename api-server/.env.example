# Skill Hub Try API · environment template
# Copy to /etc/skill-api/.env on the server, fill in real values.
# NEVER commit .env to git.

# LLM provider (OpenAI-compatible)
LLM_API_KEY=
LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
LLM_MODEL=mimo-v2.5

# Where to find SKILL.md files
SKILLS_DIR=/var/www/html/skill

# Rate limiting (anonymous IP)
RATE_LIMIT_PER_IP=3
EVAL_LIMIT_PER_IP=5

# CORS (comma-separated list of allowed origins)
ALLOW_ORIGIN=https://skill.qiuyiwu.com,https://xiaoneng.qiuyiwu.com

# Bind (NOTE: 8787 is taken by bookpress on the prod box — skill-api uses 8788)
PORT=8788

# Stable server-only secret (openssl rand -hex 32). Required for repeat copying.
# Apply migration 0004 before enabling this with the Supabase backend.
# API_KEY_COPY_SECRET=

# Optional direct PostgREST endpoint, without a /rest/v1 gateway.
# SUPABASE_REST_URL=http://127.0.0.1:8789
